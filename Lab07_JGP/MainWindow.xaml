<Window x:Class="Lab07_JGP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab07_JGP"
        mc:Ignorable="d"
        Title="CRUD de Productos"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock
            Text="CRUD de Productos"
            FontSize="28"
            FontWeight="Bold"
            Margin="0,0,0,15"/>

        <!-- FORMULARIO -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- FILA 1 -->
            <TextBlock
                Text="Nombre:"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtNombre"
                Grid.Column="1"
                Margin="5"
                Height="30"/>

            <TextBlock
                Text="Id Proveedor:"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtProveedor"
                Grid.Column="3"
                Margin="5"
                Height="30"/>


            <!-- FILA 2 -->
            <TextBlock
                Text="Id Categoría:"
                Grid.Row="1"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtCategoria"
                Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                Height="30"/>

            <TextBlock
                Text="Cantidad por unidad:"
                Grid.Row="1"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtCantidad"
                Grid.Row="1"
                Grid.Column="3"
                Margin="5"
                Height="30"/>


            <!-- FILA 3 -->
            <TextBlock
                Text="Precio:"
                Grid.Row="2"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtPrecio"
                Grid.Row="2"
                Grid.Column="1"
                Margin="5"
                Height="30"/>

            <TextBlock
                Text="Stock:"
                Grid.Row="2"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtExistencia"
                Grid.Row="2"
                Grid.Column="3"
                Margin="5"
                Height="30"/>


            <!-- FILA 4 -->
            <TextBlock
                Text="Unidades pedido:"
                Grid.Row="3"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtPedido"
                Grid.Row="3"
                Grid.Column="1"
                Margin="5"
                Height="30"/>

            <TextBlock
                Text="Nivel nuevo pedido:"
                Grid.Row="3"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtNivelPedido"
                Grid.Row="3"
                Grid.Column="3"
                Margin="5"
                Height="30"/>


            <!-- FILA 5 -->
            <TextBlock
                Text="Suspendido:"
                Grid.Row="4"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtSuspendido"
                Grid.Row="4"
                Grid.Column="1"
                Margin="5"
                Height="30"/>

            <TextBlock
                Text="Categoría producto:"
                Grid.Row="4"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"/>

            <TextBox
                x:Name="txtCategoriaProducto"
                Grid.Row="4"
                Grid.Column="3"
                Margin="5"
                Height="30"/>

        </Grid>

        <!-- BOTONES CRUD -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Margin="0,15,0,15">

            <Button
                Content="Nuevo"
                Width="100"
                Height="35"
                Margin="0,0,10,0"
                Click="btnNuevo_Click"/>

            <Button
                Content="Guardar"
                Width="100"
                Height="35"
                Margin="0,0,10,0"
                Click="btnGuardar_Click"/>

            <Button
                Content="Actualizar"
                Width="100"
                Height="35"
                Margin="0,0,10,0"
                Click="btnActualizar_Click"/>

            <Button
                Content="Eliminar"
                Width="100"
                Height="35"
                Click="btnEliminar_Click"/>

        </StackPanel>

        <!-- BUSCADOR -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Margin="0,0,0,15">

            <TextBox
                x:Name="txtBuscar"
                Width="250"
                Height="30"
                Margin="0,0,10,0"/>

            <Button
                Content="Buscar"
                Width="100"
                Height="30"
                Margin="0,0,10,0"
                Click="btnBuscar_Click"/>

            <Button
                Content="Mostrar Todos"
                Width="120"
                Height="30"
                Click="btnMostrarTodos_Click"/>

        </StackPanel>

        <!-- DATAGRID -->
        <DataGrid
        x:Name="dgProductos"
        Grid.Row="4"
        AutoGenerateColumns="True"
        IsReadOnly="True"
        CanUserAddRows="False"
        SelectionChanged="dgProductos_SelectionChanged"/>

    </Grid>

</Window>
